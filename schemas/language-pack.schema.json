{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhimo.dev/schemas/language-pack-v1.json",
  "title": "Zhimo language pack manifest",
  "type": "object",
  "required": ["schemaVersion", "id", "version", "languages", "engine", "offline", "license"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
    "version": { "type": "string" },
    "languages": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "engine": { "type": "string" },
    "offline": { "type": "boolean" },
    "license": { "type": "string", "minLength": 1 },
    "minimumRuntimeVersion": { "type": "string" },
    "resources": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
